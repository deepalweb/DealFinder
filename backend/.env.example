# MongoDB configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dealfinder?retryWrites=true&w=majority

# Legacy MongoDB URI (for reference)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dealfinder?retryWrites=true&w=majority

DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=dealfinder

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Email Configuration (for password reset, notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
M365_EMAIL=your_email@outlook.com
M365_PASSWORD=your_microsoft_365_password_or_app_password

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Configuration
# This must be the Web application OAuth client ID from Google Cloud Console.
# Make sure its Authorized JavaScript origins include your web origins, e.g.
# - http://localhost:3000
# - http://localhost:8080
# - https://dealfinderapp.lk
# - https://www.dealfinderapp.lk
# - https://drstores.lk
GOOGLE_CLIENT_ID=434034339931-01174qocrg92p7f3dck1e46el25nfc56.apps.googleusercontent.com

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Image storage: "local" for development or "r2" for Cloudflare R2
IMAGE_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=dealfinder-assets
R2_PUBLIC_URL=https://your-public-r2-host
# Set the previous image host suffix only when running the one-time R2 migration.
# LEGACY_IMAGE_HOST_SUFFIX=old-image-host.example
AI_SEARCH_ENABLED=true
AI_PERSONALIZATION_ENABLED=true

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
