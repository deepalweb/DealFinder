# Android emulator. For a physical phone, use your computer's LAN address instead.
MOBILE_API_BASE_URL=http://10.0.2.2:8080/api/
MOBILE_PUBLIC_BASE_URL=http://10.0.2.2:8080
BACKEND_URL=http://10.0.2.2:8080
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Android key: Maps SDK for Android enabled; restrict to this app's package and signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=your-restricted-android-maps-key
# iOS uses ios/Flutter/MapsConfig.xcconfig with a separate iOS-restricted key.
