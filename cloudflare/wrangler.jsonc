{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dealfinder",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": true,

  "containers": [
    {
      "class_name": "DealFinderApp",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // basic = 1/4 vCPU, 1 GiB. Bump to "standard-1" if logs show out-of-memory restarts.
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "DealFinderApp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DealFinderApp"] }],

  "triggers": { "crons": ["*/5 * * * *"] },

  // Keep production deploys from silently publishing a container that cannot
  // connect to its database, sign sessions, or store uploaded images.
  "secrets": {
    "required": [
      "MONGO_URI",
      "JWT_SECRET",
      "JWT_REFRESH_SECRET",
      "R2_ACCOUNT_ID",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY"
    ]
  },

  // The apex and www hostnames are attached to this Worker in Cloudflare.
  "routes": [
    { "pattern": "dealfinderapp.lk", "custom_domain": true },
    { "pattern": "www.dealfinderapp.lk", "custom_domain": true }
  ],

  // Plain (non-secret) settings. Secrets go in with `npx wrangler secret put NAME`.
  "vars": {
    "APP_URL": "https://dealfinderapp.lk",
    "DATA_SOURCE": "mongo",
    "R2_BUCKET": "dealfinder-assets",
    "R2_PUBLIC_URL": "https://pub-50a3238301f643b4b97879c1e4d6041d.r2.dev"
  }
}
